#products > ul > li .price-table .price-area {
  background: #4bc4ff;
  display: inline-block;
  margin-bottom: 35px;
  position: absolute;
  width: 100%;
  padding: 20px 0px 9px 0px;
  color: #fff;
  border-radius: none !important;
  left: 0;
  top: 100px;
}
#order-pure_comparison .price-table-container .price-table .top-head .top-area {
    padding: 10px !important;
    margin: 0 0 0 0;
    height: 100px;
    display: grid
;
    align-content: center;
}
#order-pure_comparison .price-table-container .price-table .top-head .top-area h4 {
    font-size: 19px !important;
		line-height: 24px !important;
}
#order-pure_comparison .price-table-container .price-table {
  padding: 0 0 0 0;
  margin: 0 0 0 0;
  width: 100%;
  background: #ffffff;
  -moz-border-radius: 5px;
  -webkit-border-radius: 5px;
  -ms-border-radius: 5px;
  border-radius: 5px;
  -webkit-box-shadow: 0 1px 2px 0 rgba(0,0,0,0.30);
  -moz-box-shadow: 0 1px 2px 0 rgba(0,0,0,0.30);
  box-shadow: 0 1px 2px 0 rgba(0,0,0,0.30);
  overflow: hidden;
  position: relative;
}
#products > ul > li .price-table .price-area:before {
  border-top: 21px solid #4bc4ff;
  border-left: 200px solid transparent;
  border-right: 200px solid transparent;
  margin-left: -200px;
  margin-right: -200px;
  content: "";
  height: 0;
  position: absolute;
  bottom: -20px;
  width: 0;
  left: 50%;
}
#products > ul > li .price-table > ul {
  margin-top: 150px !important;
}

#products > ul > li .price-table > ul > li:nth-of-type(1) {
  border: none !important;
}
#products > ul > li .price-table > ul > li {
	font-size: 15px !important;
}
#order-pure_comparison .price-table-container .price-area .price {
       padding: 10px 0 10px 0;
    font-size: 15px;
    font-weight: 700;
    color: #212121;
}
#order-pure_comparison .price-table-container .price-area .price span {
    font-size: 36px !important;
	font-weight: 500 !important;
}
#products > ul > li .price-table .top-head {
  background: #00acff;
  -webkit-border-radius: 5px 5px 0 0;
  background: linear-gradient(to bottom, #a4f2ffcc 0%,#f6f6f6b0 100%);
  background: #fff !important;
}
#products > ul > li .price-table .order-button {
  color: #5b5e61;
  font-size: 14px;
  background: #fff;
  padding: 11px 20px;
  border-radius: 3px;
  text-transform: uppercase;
  font-weight: 400;
  transition: all 0.3s ease;
  display: inline-block;
}
h2 {
	font-size: 32px !important;
}
@media(max-width: 768px) {	
	h2 {
		font-size: 28px !important;
	}
}
</style>
